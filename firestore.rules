rules_version = '2';

// Morpheus Class Planner: who may read and write what.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
//
//   users/{uid}        a person's access: role 'pending' | 'tutor' | 'admin', tutorId
//   tutors/{tutorId}   tutor list (a tutor reads only their own)
//   tutorRates, students, payments           admin only (tutors never receive them)
//   settings/app       school settings (admins write, tutors read)
//   classes/{classId}  one class: the admin's plan plus `progress`, the only part
//                      the class's tutor may change (status, attendance, notes, statusLog)
//   dayNotes/{tutorId_date}  the admin's note for one tutor on one day (the tutor reads their own)
//   meta/public        exists once the app is set up; readable before sign-in
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return signedIn() && exists(userDoc(request.auth.uid)); }
    function me() { return get(userDoc(request.auth.uid)).data; }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isTutor() { return hasProfile() && me().role == 'tutor' && me().tutorId is string; }
    function myTutorId() { return me().tutorId; }
    function myEmail() { return request.auth.token.email.lower(); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // First run: until meta/public exists, the signed-in person may make themselves the admin,
    // in the same batch that creates meta/public. After that, only admins give access.
    function setupOpen() { return !exists(/databases/$(database)/documents/meta/public); }
    function adminAfter() { return getAfter(userDoc(request.auth.uid)).data.role == 'admin'; }

    match /meta/public {
      allow read: if true;
      allow create: if signedIn() && setupOpen() && adminAfter();
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        // the first admin, during setup
        || (signedIn() && request.auth.uid == uid && setupOpen()
            && request.resource.data.role == 'admin'
            && request.resource.data.email == myEmail()
            && existsAfter(/databases/$(database)/documents/meta/public))
        // anyone else who signs in waits until an admin gives them access
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'pending'
            && request.resource.data.tutorId == null
            && request.resource.data.email == myEmail()
            && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'role', 'tutorId', 'createdAt', 'lastLoginAt']));
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && changedOnly(['displayName', 'photoURL', 'lastLoginAt']));
      allow delete: if isAdmin();
    }

    match /tutors/{tutorId} {
      allow read: if isAdmin() || (isTutor() && myTutorId() == tutorId);
      allow write: if isAdmin();
    }

    match /tutorRates/{tutorId} {
      allow read, write: if isAdmin();
    }

    match /students/{studentId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin() || isTutor();
      allow create: if isAdmin() || (signedIn() && setupOpen() && adminAfter());
      allow update, delete: if isAdmin();
    }

    match /dayNotes/{noteId} {
      // a tutor's query must ask for their own notes: where('tutorId', '==', theirId)
      allow read: if isAdmin() || (isTutor() && resource.data.tutorId == myTutorId());
      allow write: if isAdmin();
    }

    // statusLog: who changed a class's status. A tutor may leave it as it is, or add an entry that names themselves.
    function statusLogOk(p, prior) {
      return p.get('statusLog', []) == prior.get('statusLog', [])
        || (p.statusLog is list && p.statusLog.size() > 0 && p.statusLog.size() <= 30
            && p.statusLog[p.statusLog.size() - 1].by == request.auth.uid
            && p.statusLog[p.statusLog.size() - 1].to == p.status);
    }

    match /classes/{classId} {
      // a tutor's query must ask for their own classes: where('tutorId', '==', theirId)
      allow read: if isAdmin() || (isTutor() && resource.data.tutorId == myTutorId());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isTutor() && resource.data.tutorId == myTutorId()
        && changedOnly(['progress'])
        && request.resource.data.progress.keys().hasOnly(['status', 'attendance', 'tutorChecklist', 'lessonNotes', 'updatedAt', 'updatedBy', 'statusLog'])
        && request.resource.data.progress.status in ['todo', 'in_progress', 'completed']
        && request.resource.data.progress.updatedBy == request.auth.uid
        && statusLogOk(request.resource.data.progress, resource.data.get('progress', {}))
      );
    }
  }
}
